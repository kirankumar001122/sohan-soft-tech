# Canonical deployment origin for metadata, robots.txt, and sitemap.xml.
# Vercel host variables are used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep this server-side only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Configure only real team availability. Weekdays use 0=Sunday through 6=Saturday.
# Times use 24-hour HH:MM in Asia/Kolkata; end time is the end of the booking window.
DEMO_BOOKING_DAYS=
DEMO_BOOKING_START_TIME=
DEMO_BOOKING_END_TIME=
DEMO_BOOKING_DURATION_MINUTES=